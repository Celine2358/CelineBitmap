<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CelineBitmap.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="CelineBitmap.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

        Title="Celine Bitmap"
        Width="1100" Height="720"
        MinWidth="850" MinHeight="560"
        Icon="/Assets/CelineBitmap-Icon.ico"
        Background="{StaticResource CelineBackgroundBrush}"
        FontFamily="{StaticResource CelineFont}">


    <Grid RowDefinitions="68, *">
		<!-- 상단 부분 68px -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource CelineBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,10">

            <!-- 아이콘 / 제목 / 이미지 열기 버튼 -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Width="42" Height="42" Source="/Assets/CelineBitmap-Icon.png"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">

                    <TextBlock Text="Celine Bitmap"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CelineTextBrush}"/>

                    <TextBlock Text="OpenCV Image Laboratory"
                               FontSize="11"
                               Foreground="{StaticResource CelineSubTextBrush}"/>

                </StackPanel>

                <Button Grid.Column="2" Content="Open Image" VerticalAlignment="Center" Click="OpenImageButton_Click"/>
            </Grid>
        </Border>

        <!-- 메인 작업 공간 -->
        <Grid Grid.Row="1"
              Margin="20"
              ColumnDefinitions="*,280"
              ColumnSpacing="16">

            <!-- 이미지 미리보기 -->
            <Border Grid.Column="0" Background="White"
                    BorderBrush="{StaticResource CelineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12">
                
                <Grid>
                    <!-- 실제 이미지 -->
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    
                    <!-- 이미지가 없을 때 보여주는 안내 -->
                    <StackPanel x:Name="EmptyImageMessage"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        
                        <TextBlock Text="Celine Bitmap" FontSize="20"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource CelinePrimaryBrush}"/>
                        
                        <TextBlock Text="이미지를 열어 작업을 시작하세요." FontSize="13"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 이미지 설정 도구 -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="{StaticResource CelineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18">

                <StackPanel Spacing="12">
                    <!-- 설정 패널 제목 -->
                    <TextBlock Text="이미지 설정" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource CelineTextBrush}"/>

                    <!-- 이미지 너비 설정 -->
                    <TextBlock Text="너비(Width)" Foreground="{StaticResource CelineSubTextBrush}"/>

                    <!-- NumericUpDown은 숫자를 입력 혹은 위/아래 화살표 버튼으로 값을 증가/감소시키는 입력 컨트롤 -->
                    <NumericUpDown x:Name="WidthInput" Value="1024" Minimum="1" Maximum="16384"/>
                    <!-- 이미지 높이 설정 -->
                    <TextBlock Text="높이(Height)" Foreground="{StaticResource CelineSubTextBrush}"/>

                    <NumericUpDown x:Name="HeightInput" Value="1024" Minimum="1" Maximum="16384"/>
                    <!-- 이미지 크기 변경 시 사용할 보간법 -->
                    <TextBlock Text="보간법(Interpolation)" Foreground="{StaticResource CelineSubTextBrush}"/>

                    <!-- 보간법 선택 -->
                    <ComboBox x:Name="InterpolationComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="Lanczos4"/>
                        <ComboBoxItem Content="Cubic"/>
                        <ComboBoxItem Content="Area"/>
                        <ComboBoxItem Content="Nearest"/>
                    </ComboBox>

                    <!-- 설정한 Width / Height로 이미지 크기 변경 -->
                    <Button Content="리사이즈" Margin="0,10,0,0" Click="ResizeButton_Click"/>
                    <!-- 저장 버튼 -->
                    <Button Content="이미지 저장" Click="SaveImageButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>