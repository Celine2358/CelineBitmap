<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CelineBitmap.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="CelineBitmap.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

        Title="Celine Bitmap"
        Width="1280" Height="720"
        MinWidth="900" MinHeight="580"
        Icon="/Assets/CelineBitmap-Icon.ico"
        Background="{StaticResource CelineBackgroundBrush}"
        FontFamily="{StaticResource CelineFont}">


    <Grid RowDefinitions="68, *">
		<!-- 상단 부분 68px -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource CelineBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,10">

            <!-- 아이콘 / 제목 / 이미지 열기 버튼 -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Width="42" Height="42" Source="/Assets/CelineBitmap-Icon.png"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">

                    <TextBlock Text="Celine Bitmap"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CelineTextBrush}"/>

                    <TextBlock Text="OpenCV Image Laboratory"
                               FontSize="11"
                               Foreground="{StaticResource CelineSubTextBrush}"/>

                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    
                    <Button Content="이미지 열기" Click="OpenImageButton_Click"/>
                    <Button x:Name="SaveImageButton" Content="이미지 저장" Click="SaveImageButton_Click" IsEnabled="True"/>
                    <Button Content="실험실" Click="OpenLabButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 메인 작업 공간 -->
        <Grid Grid.Row="1"
              Margin="20"
              ColumnDefinitions="*,280"
              ColumnSpacing="16">

            <!-- 비포 / 애프터 이미지 미리보기 -->
            <Border Grid.Column="0" Background="White"
                    BorderBrush="{StaticResource CelineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                
                <Grid RowDefinitions="Auto,*">
                    
                    <TextBlock Grid.Row="0" Text="Image Preview"
                               Margin="4,0,0,12"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CelineTextBrush}"/>
                    
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                        
                        <!-- Before -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,*">
                            
                            <TextBlock Text="Before"
                                       Margin="4,0,0,6"
                                       Foreground="{StaticResource CelineSubTextBrush}"/>
                            
                            <Border Grid.Row="1"
                                    Background="#F8FBFF"
                                    BorderBrush="{StaticResource CelineBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8">

                    <Image x:Name="BeforeImage" Stretch="Uniform"/>
                </Border>
            </Grid>
                        
                        <!-- After -->
                        <Grid Grid.Column="1" RowDefinitions="Auto,*">
                            
                            <TextBlock Text="After"
                                       Margin="4,0,0,6"
                                       Foreground="{StaticResource CelineSubTextBrush}"/>
                            
                            <Border Grid.Row="1"
                                    Background="#F8FBFF"
                                    BorderBrush="{StaticResource CelineBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8">

                    <Image x:Name="AfterImage" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Border>

            <!-- 이미지 설정 도구 -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="{StaticResource CelineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18">
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        
                        <TextBlock Text="이미지 설정"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CelineTextBrush}"/>
                        
                        <!-- 원본 크기 -->
                        <TextBlock Text="Original Size"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <TextBlock x:Name="OriginalSizeText"
                                   Text="No Image"
                                   FontSize="15"
                                   Foreground="{StaticResource CelineTextBrush}"/>
                        
                        <Border Height="1"
                                Margin="0,6"
                                Background="{StaticResource CelineBorderBrush}"/>
                        
                        <!-- Resize -->
                        <TextBlock Text="리사이즈"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CelineTextBrush}"/>
                        
                        <!-- 이미지 너비 설정 -->
                        <TextBlock Text="너비(Width)"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <!-- NumericUpDown은 숫자를 입력 혹은 위/아래 화살표 버튼으로 값을 증가/감소시키는 입력 컨트롤 -->
                        <!-- Value는 Decimal 자료형 -->
                        <NumericUpDown x:Name="WidthInput"
                                       Value="1024"
                                       Minimum="1"
                                       Maximum="16384"
                                       ValueChanged="WidthInput_ValueChanged"/>
                        
                        <!-- 이미지 높이 설정 -->
                        <TextBlock Text="높이(Height)"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <NumericUpDown x:Name="HeightInput"
                                       Value="1024"
                                       Minimum="1"
                                       Maximum="16384"
                                       ValueChanged="HeightInput_ValueChanged"/>
                        
                        <!-- 비율 잠금 체크박스 -->
                        <CheckBox x:Name="KeepAspectRatioCheckBox"
                                  Content="이미지 비율 잠금"
                                  IsChecked="True"/>
                        
                        <!-- 이미지 배율 정하기 -->
                        <TextBlock Text="배율(Scale)"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <WrapPanel ItemSpacing="4" LineSpacing="4">
                            <Button Content="25%"
                                    Tag="0.25"
                                    Click="ScaleButton_Click"/>
                            
                            <Button Content="50%"
                                    Tag="0.5"
                                    Click="ScaleButton_Click"/>
                            
                            <Button Content="100%"
                                    Tag="1"
                                    Click="ScaleButton_Click"/>
                            
                            <Button Content="200%"
                                    Tag="2"
                                    Click="ScaleButton_Click"/>
                            
                            <Button Content="400%"
                                    Tag="4"
                                    Click="ScaleButton_Click"/>
                        
                        </WrapPanel>
                        <TextBlock Text="보간법(Interpolation)"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <ComboBox x:Name="InterpolationComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="Lanczos4"/>
                            <ComboBoxItem Content="Cubic"/>
                            <ComboBoxItem Content="Area"/>
                            <ComboBoxItem Content="Nearest"/>
                        </ComboBox>
                        
                        <Button Content="Resize"
                                Margin="0,4,0,0"
                                Click="ResizeButton_Click"/>
                        
                        <Button Content="Reset Original"
                                Click="ResetButton_Click"/>
                        
                        <Border Height="1"
                                Margin="0,8"
                                Background="{StaticResource CelineBorderBrush}"/>
                        
                        <!-- 이미지 실험실 -->
                        <TextBlock Text="Image Laboratory"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CelineTextBrush}"/>
                        
                        <!-- 밝기 -->
                        <TextBlock Text="밝기(Brightness)"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <Slider x:Name="BrightnessSlider"
                                Minimum="-100"
                                Maximum="100"
                                Value="0"
                                TickFrequency="10"
                                ValueChanged="ColorSlider_ValueChanged"/>
                        
                        <!-- 색 대비 -->
                        <TextBlock Text="대비(Contrast)"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <Slider x:Name="ContrastSlider"
                                Minimum="0"
                                Maximum="200"
                                Value="100"
                                TickFrequency="10"
                                ValueChanged="ColorSlider_ValueChanged"/>
                        
                        <!-- 채도 -->
                        <TextBlock Text="채도(Saturation)"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <Slider x:Name="SaturationSlider"
                                Minimum="0"
                                Maximum="200"
                                Value="100"
                                TickFrequency="10"
                                ValueChanged="ColorSlider_ValueChanged"/>
                        
                        <TextBlock Text="Filters"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <WrapPanel ItemSpacing="5" LineSpacing="5">
                            <ToggleButton x:Name="GrayscaleToggle"
                                          Content="Grayscale"
                                          Click="FilterToggle_Click"/>
                            
                            <ToggleButton x:Name="BlurToggle"
                                          Content="Blur"
                                          Click="FilterToggle_Click"/>
                            
                            <ToggleButton x:Name="SharpenToggle"
                                          Content="Sharpen"
                                          Click="FilterToggle_Click"/>
                            
                            <ToggleButton x:Name="EdgeToggle"
                                          Content="Edge"
                                          Click="FilterToggle_Click"/>
                        </WrapPanel>

                        <Border Height="1" Margin="0,8"
                                Background="{StaticResource CelineBorderBrush}"/>
                        
                        <TextBlock Text="픽셀아트(Pixel Art)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource CelineTextBrush}"/>
                        
                        <TextBlock Text="픽셀 해상도"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <NumericUpDown x:Name="PixelWidthInput"
                                       Minimum="16"
                                       Maximum="512"
                                       Value="96"/>
                        
                        <TextBlock Text="Palette Colors"
                                   Foreground="{StaticResource CelineSubTextBrush}"/>
                        
                        <ComboBox x:Name="PaletteColorCombo" SelectedIndex="2">
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="16"/>
                            <ComboBoxItem Content="32"/>
                            <ComboBoxItem Content="64"/>
                        </ComboBox>
                        
                        <CheckBox x:Name="PixelSmoothCheckBox"
                                  Content="경계를 보존하는 부드러움(Edge-preserving smoothing)"
                                  IsChecked="True"/>
                        
                        <Button Content="Pixel Art 변환" Click="PixelArtButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>